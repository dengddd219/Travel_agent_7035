# ============================================================
# Travel Agent 7035 — 环境变量配置模板
# 复制本文件为 .env，然后填入真实的 API Key
# cp .env.example .env
# ============================================================

# ── Azure OpenAI（必填）────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://你的资源名.openai.azure.com/
AZURE_OPENAI_API_KEY=你的AzureOpenAI密钥
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# ── Azure AI Foundry（与上面二选一，或同时填）─────────────────────────────────
FOUNDRY_PROJECT_RESOURCE=你的Foundry资源名
FOUNDRY_PROJECT_API_KEY=你的Foundry密钥
FOUNDRY_PROJECT_DEPLOYMENT=gpt-5-mini
FOUNDRY_PROJECT_ENDPOINT=https://你的资源名.services.ai.azure.com/api/projects/你的项目名

# ── 高德地图 API（可选，缺失时地图功能降级）──────────────────────────────────
AMAP_API_KEY=你的高德Web端密钥

# ── Tavily 搜索（可选，缺失时旅行贴士使用本地数据）──────────────────────────
TAVILY_API_KEY=你的Tavily密钥

# ── Group C 天气/酒店模块（在 4-cost/Group_C/Group_C/.env 中单独配置）────────
# AMAP_WEB_SERVICE_KEY=你的高德Web服务密钥
# USE_PLAYWRIGHT_SCRAPER=false
# ALLOW_MOCK_DATA=true
