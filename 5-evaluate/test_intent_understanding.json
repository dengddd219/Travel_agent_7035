{
  "version": "0.1",
  "benchmark": "travel_agent_7035_intent_understanding",
  "description": "层次一：意图理解测试集。覆盖标准输入、口语模糊、隐含信息、多槽位、多轮增量五类场景，共110条，全中文。",
  "scoring": {
    "method": "per_slot_weighted",
    "slots": {
      "city":         { "weight": 1.0, "type": "exact_match_after_alias_normalize" },
      "trip_days":    { "weight": 1.0, "type": "exact_int" },
      "travel_type":  { "weight": 1.0, "type": "exact_match", "valid_values": ["family", "food", "theme", "leisure"] },
      "budget_level": { "weight": 0.5, "type": "exact_match", "valid_values": ["low", "medium", "high"] },
      "pace":         { "weight": 0.5, "type": "exact_match", "valid_values": ["slow", "balanced", "packed"] },
      "must_visit":   { "weight": 0.5, "type": "set_exact" },
      "avoid":        { "weight": 0.5, "type": "set_exact" }
    },
    "pass_threshold": 0.85
  },
